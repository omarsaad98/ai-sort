{
  "name": "ai-sort",
  "version": "0.1.0",
  "description": "Sort a list of strings by how well each fits a prompt, using an LLM (Ollama or OpenAI) as a pairwise comparator",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "ai-sort": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "test": "npm run build && node --test \"dist/**/*.test.js\"",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "llm",
    "sort",
    "ranking",
    "ollama",
    "openai",
    "cli"
  ],
  "license": "MIT",
  "dependencies": {
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=18.17"
  }
}
